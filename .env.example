# Gemini VLM & Embeddings (google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Pinecone Vector DB (pinecone v5+ SDK - optional, falls back to local JSON/NumPy index)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sieveaudit-episodes
PINECONE_NAMESPACE=default

# vlm-sieve Gatekeeper & Target VLM Alignment
DEFAULT_TARGET_VLM=qwen-vl
SIEVE_SAMPLE_FPS=10.0
SIEVE_TILE_MAX_DIM=640
